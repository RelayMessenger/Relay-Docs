{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.relayapp.im/schemas/responding.schema.json",
  "title": "Begin responding request",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id"],
  "properties": {
    "message_id": {
      "type": "string",
      "pattern": "^msg_"
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^ivk_[0-9a-hjkmnp-tv-z]{26}$"
    }
  }
}
