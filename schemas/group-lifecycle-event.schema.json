{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://relayapp.im/schemas/group-lifecycle-event.schema.json",
 "title": "Relay group lifecycle",
 "description": "What a roster or metadata change produces. Two things land together and describe the same mutation: an event in every member's log (participant.added / participant.removed for roster changes, chat.group_name_updated / chat.group_icon_updated for metadata), and a NOTICE MESSAGE in the chat. A notice is a message carrying a `group_event` \u2014 member_added, member_left, member_removed, name_changed or photo_changed \u2014 sent by the person who did the thing, carrying no parts. Its structured fields are authoritative; `fallback_text` is the rendered line for clients that will not render the structured form. The event is what tells them the roster moved.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "chat_id",
  "actor",
  "membership_version",
  "message"
 ],
 "properties": {
  "chat_id": {
   "$ref": "#/$defs/chatId"
  },
  "actor": {
   "$ref": "#/$defs/actor",
   "description": "The person who made the change. Only humans mutate a group."
  },
  "affected_participant": {
   "$ref": "#/$defs/participant",
   "description": "Present on every roster mutation; absent on creation and metadata changes."
  },
  "membership_version": {
   "type": "integer",
   "minimum": 1
  },
  "message": {
   "$ref": "https://api.relayapp.im/schemas/message-v2.schema.json#/$defs/Message",
   "description": "The notice, committed through the one message path, so every member's log, push and the chat sequence see it exactly like any other message."
  },
  "event_data": {
   "oneOf": [
    {
     "$ref": "#/$defs/RosterEventData"
    },
    {
     "$ref": "#/$defs/MetadataEventData"
    }
   ],
   "description": "The `data` of the participant.* or chat.group_*_updated event that accompanies the notice."
  }
 },
 "$defs": {
  "chatId": {
   "type": "string",
   "pattern": "^cnv_[0-9a-hjkmnp-tv-z]{26}$"
  },
  "actor": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "id"
   ],
   "properties": {
    "kind": {
     "const": "user"
    },
    "id": {
     "type": "string",
     "pattern": "^usr_[0-9a-hjkmnp-tv-z]{26}$"
    }
   }
  },
  "participant": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "id"
   ],
   "properties": {
    "kind": {
     "enum": [
      "user",
      "agent"
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^(usr|agt)_[0-9a-hjkmnp-tv-z]{26}$"
    }
   }
  },
  "RosterEventData": {
   "title": "participant.added / participant.removed data",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "chat_id",
    "actor",
    "affected_participant"
   ],
   "properties": {
    "chat_id": {
     "$ref": "#/$defs/chatId"
    },
    "actor": {
     "$ref": "#/$defs/actor"
    },
    "affected_participant": {
     "$ref": "#/$defs/participant"
    }
   }
  },
  "MetadataEventData": {
   "title": "chat.group_name_updated / chat.group_icon_updated data",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "chat_id",
    "old_value",
    "new_value",
    "changed_by_handle",
    "updated_at"
   ],
   "properties": {
    "chat_id": {
     "$ref": "#/$defs/chatId"
    },
    "old_value": {
     "type": [
      "string",
      "null"
     ]
    },
    "new_value": {
     "type": [
      "string",
      "null"
     ]
    },
    "changed_by_handle": {
     "$ref": "#/$defs/actor"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "message": {
      "type": "object",
      "properties": {
       "group_event": {
        "type": "object",
        "properties": {
         "event_type": {
          "enum": [
           "member_added",
           "member_left",
           "member_removed"
          ]
         }
        },
        "required": [
         "event_type"
        ]
       }
      },
      "required": [
       "group_event"
      ]
     }
    },
    "required": [
     "message"
    ]
   },
   "then": {
    "properties": {
     "affected_participant": {
      "$ref": "#/$defs/participant"
     }
    },
    "required": [
     "affected_participant"
    ]
   }
  }
 ]
}
