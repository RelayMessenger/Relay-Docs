{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayapp.im/schemas/agent-conversations.schema.json",
  "title": "Relay agent conversation list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversations"],
  "properties": {
    "conversations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/conversation" }
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque cursor for the next page. Omitted when no later page exists."
    }
  },
  "$defs": {
    "counterpartUser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "username", "avatar_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^usr_" },
        "display_name": { "type": "string" },
        "username": {
          "type": ["string", "null"],
          "description": "The handle this person claimed, or null before they claim one."
        },
        "avatar_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "counterpart_user",
        "participant_count",
        "last_sequence",
        "last_message_at",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^cnv_" },
        "kind": { "type": "string", "enum": ["direct", "group"] },
        "title": { "type": ["string", "null"] },
        "counterpart_user": {
          "description": "The active human in a direct user-agent conversation; null for groups.",
          "oneOf": [
            { "$ref": "#/$defs/counterpartUser" },
            { "type": "null" }
          ]
        },
        "participant_count": { "type": "integer", "minimum": 1 },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "last_message_at": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "detailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation"],
      "properties": {
        "conversation": { "$ref": "#/$defs/conversation" }
      }
    }
  }
}
