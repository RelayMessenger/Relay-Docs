{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.relayapp.im/schemas/parts/data-group_invite.schema.json",
  "title": "Relay group invite component data",
  "description": "A server-committed consent card in a target user's direct conversation with the proposing agent. Agents cannot send this data shape through the ordinary message endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "invite_id", "title", "expires_at", "members"],
  "properties": {
    "type": { "const": "group_invite" },
    "invite_id": { "type": "string", "pattern": "^inv_" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": ".*\\S.*" },
    "expires_at": { "type": "string", "format": "date-time" },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^cnv_" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": ".*\\S.*" }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "display_name", "avatar_url", "state"],
      "properties": {
        "user_id": { "type": "string", "pattern": "^usr_" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": ".*\\S.*" },
        "avatar_url": { "type": ["string", "null"] },
        "state": { "type": "string", "enum": ["invited", "accepted", "declined"] }
      }
    }
  }
}
