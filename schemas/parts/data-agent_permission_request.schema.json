{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.relayapp.im/schemas/parts/data-agent_permission_request.schema.json",
  "title": "Relay agent permission request component data",
  "description": "Consumers must ignore unknown fields inside this known kind. The option_ids array name is reserved for a future multi-select tap-result shape; v1 does not implement multi-select.",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "request_id", "options"],
  "properties": {
    "kind": { "const": "agent_permission_request" },
    "request_id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "prompt": { "type": "string", "maxLength": 1024 },
    "fallback": { "type": "string" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "origin"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_.:-]+$", "description": "Opaque option ID limited to 200 bytes. The ASCII-only charset makes bytes equal characters." },
        "label": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": ".*\\S.*" },
        "style": { "enum": ["default", "primary", "danger"] },
        "origin": { "type": "object" },
        "disabled": { "type": "boolean" },
        "description": false,
        "url": false
      }
    }
  }
}
