{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.relayapp.im/schemas/parts/data-card.schema.json",
  "title": "Relay card component data",
  "description": "Consumers must ignore unknown fields inside this known kind. The option_ids array name is reserved for a future multi-select tap-result shape; v1 does not implement multi-select.",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "title"],
  "properties": {
    "kind": { "const": "card" },
    "media": {
      "type": "object",
      "additionalProperties": true,
      "oneOf": [
        {
          "required": ["attachment_id"],
          "properties": { "attachment_id": true }
        },
        {
          "required": ["url"],
          "properties": { "url": true }
        }
      ],
      "properties": {
        "attachment_id": { "type": "string", "pattern": "^att_" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://(?![^/?#]*@)" }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": ".*\\S.*" },
    "subtitle": { "type": "string", "maxLength": 60 },
    "caption": { "type": "string", "maxLength": 60 },
    "trailing_caption": { "type": "string", "maxLength": 60 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://(?![^/?#]*@)" },
    "fallback": { "type": "string" },
    "options": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_.:-]+$", "description": "Opaque option ID limited to 200 bytes. The ASCII-only charset makes bytes equal characters." },
        "label": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": ".*\\S.*" },
        "description": { "type": "string", "maxLength": 72 },
        "style": { "enum": ["default", "primary", "danger"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://(?![^/?#]*@)" },
        "disabled": { "type": "boolean" },
        "origin": false
      }
    }
  }
}
