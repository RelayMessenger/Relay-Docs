[
  {
    "name": "buttons",
    "title": "Buttons",
    "description": "A vertical option stack attached to an agent message.",
    "since": "v1",
    "schema": "schemas/parts/data-buttons.schema.json",
    "examples": [
      "examples/components/buttons-send.json",
      "examples/components/buttons-stored.json",
      "examples/components/buttons-tap-result.json"
    ],
    "constraints": ["1-5 options", "option labels 1-24 characters", "at most one primary option"],
    "ios_view": "ComponentButtons"
  },
  {
    "name": "select",
    "title": "Select",
    "description": "A collapsed row that opens a native single-select sheet.",
    "since": "v1",
    "schema": "schemas/parts/data-select.schema.json",
    "examples": [
      "examples/components/select-send.json",
      "examples/components/select-stored.json",
      "examples/components/select-tap-result.json"
    ],
    "constraints": ["1-5 sections", "12 options total", "button label 1-20 characters"],
    "ios_view": "ComponentSelect"
  },
  {
    "name": "card",
    "title": "Card",
    "description": "A slot-based media card with up to two actions.",
    "since": "v1",
    "schema": "schemas/parts/data-card.schema.json",
    "examples": [
      "examples/components/card-send.json",
      "examples/components/card-stored.json",
      "examples/components/card-tap-result.json"
    ],
    "constraints": ["title 1-60 characters", "0-2 options", "media uses one attachment_id or HTTPS URL"],
    "ios_view": "ComponentCard"
  },
  {
    "name": "confirm",
    "title": "Confirm",
    "description": "A two-role confirm and deny decision pair.",
    "since": "v1",
    "schema": "schemas/parts/data-confirm.schema.json",
    "examples": [
      "examples/components/confirm-send.json",
      "examples/components/confirm-stored.json",
      "examples/components/confirm-tap-result.json"
    ],
    "constraints": ["one confirm option", "one deny option", "prompt at most 1024 characters"],
    "ios_view": "ComponentConfirm"
  },
  {
    "name": "agent_permission_request",
    "title": "Agent permission request",
    "description": "A relaymessenger permission decision whose option origins are echoed verbatim.",
    "since": "v1",
    "schema": "schemas/parts/data-agent_permission_request.schema.json",
    "examples": [
      "examples/components/agent_permission_request-send.json",
      "examples/components/agent_permission_request-stored.json",
      "examples/components/agent_permission_request-tap-result.json"
    ],
    "constraints": ["non-empty request_id", "each option carries origin", "integration-owned fields are preserved"],
    "ios_view": "ComponentConfirm"
  }
]
