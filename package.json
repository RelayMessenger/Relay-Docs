{
  "name": "relay-docs",
  "private": true,
  "scripts": {
    "build:agent-prompt": "python3 scripts/build-agent-prompt.py",
    "build:llms": "python3 scripts/build-llms.py",
    "check:llms": "python3 scripts/build-llms.py --check",
    "check:openapi-bundle": "scripts/check-mint-openapi.sh",
    "check:staging-origins": "python3 scripts/build-staging-openapi.py --check && python3 scripts/validate-staging-origins.py",
    "check:api-navigation": "python3 scripts/test-api-navigation.py",
    "check:promote-workflow": "python3 scripts/test-promote-workflow.py",
    "check:environments": "python3 scripts/test-environments.py",
    "check:contract-source": "python3 scripts/test-contract-source.py",
    "check:hosted-cache": "python3 scripts/test-hosted-cache.py && python3 scripts/test-hosted-environments.py",
    "check:versions": "node scripts/check-versions.mjs",
    "dev": "mintlify dev",
    "refresh:versions": "node scripts/refresh-versions.mjs",
    "validate": "npm run check:guides && npm run check:error-anchors && npm run check:cli-reference && npm run check:openapi-bundle && npm run check:staging-origins && npm run check:contract-source && npm run check:agent-onboarding && npm run check:hosted-cache && npm run check:api-navigation && npm run check:structure && npm run check:integration-docs && npm run check:promote-workflow && npm run check:versions && npm run check:environments && python3 scripts/build-agent-prompt.py --check && npm run check:llms && node --check agent-prompt.js && python3 scripts/validate-docs.py && python3 scripts/validate-examples.py && mintlify broken-links && mintlify validate && mintlify a11y",
    "validate:ecosystem-hosted": "node scripts/validate-ecosystem-hosted.mjs",
    "validate:hosted-llms": "python3 scripts/validate-hosted-llms.py",
    "check:agent-onboarding": "python3 scripts/test-agent-onboarding.py",
    "check:structure": "python3 scripts/test-docs-structure.py && python3 scripts/test-docs-links.py",
    "check:integration-docs": "python3 scripts/test-integration-docs.py",
    "build:cli-reference": "node scripts/build-cli-reference.mjs",
    "check:cli-reference": "node scripts/build-cli-reference.mjs --check && python3 scripts/test-cli-reference.py",
    "check:error-anchors": "python3 scripts/check-error-anchors.py",
    "check:guides": "python3 scripts/check-guides.py"
  },
  "devDependencies": {
    "mintlify": "4.2.850",
    "relaymessenger": "0.1.6-staging.37"
  }
}
