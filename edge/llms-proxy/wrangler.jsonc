{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-docs-llms-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt"
      ],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "relay-docs-llms-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.staging.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-staging.mintlify.app",
        "PROXY_TAG": "cloudflare-staging",
        "LLMS_VERSION": "67b97b0657e01fd74cb4ccb9e48a1387f195575f0bef59f33a997649eb5470f1",
        "LLMS_FULL_VERSION": "03414867d5120538e105be700ccc1a5644f581af1f83c083fcbbb69c7bb5daf7"
      }
    },
    "production": {
      "name": "relay-docs-llms-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-app.mintlify.app",
        "PROXY_TAG": "cloudflare-production",
        "LLMS_VERSION": "67b97b0657e01fd74cb4ccb9e48a1387f195575f0bef59f33a997649eb5470f1",
        "LLMS_FULL_VERSION": "03414867d5120538e105be700ccc1a5644f581af1f83c083fcbbb69c7bb5daf7"
      }
    }
  }
}
