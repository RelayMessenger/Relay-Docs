{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-docs-llms-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "relay-docs-llms-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.staging.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-staging.mintlify.app",
        "LLMS_VERSION": "c02832ec0faad76b907d6de83cddb6fb5b24ac7c63129c98dc36f132211b9ba5",
        "LLMS_FULL_VERSION": "28651ac0559cd0b2c13734e2380f1753049d521177e450fe0088bcb3bc79ac7a"
      }
    }
  }
}
