{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-docs-llms-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "relay-docs-llms-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.staging.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-staging.mintlify.app",
        "LLMS_VERSION": "ed02f53486f82fdb51e3ff5345461183a8c06bc34eaae1cfabd5c757368c3aaa",
        "LLMS_FULL_VERSION": "9f5f0b8cde4fc522fc4b9da4b387ec4b6a7cfa52dd77a9ea68f616e7c16269d9"
      }
    }
  }
}
