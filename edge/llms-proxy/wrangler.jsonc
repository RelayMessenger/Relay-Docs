{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-docs-llms-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "relay-docs-llms-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.staging.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-staging.mintlify.app",
        "LLMS_VERSION": "6acb30b25a4bc9b59e838587c681a5b61b810825db646f64ba9aa04c98114337",
        "LLMS_FULL_VERSION": "81449fc0d7abfd9d9f878ec2aea7b3c4b89f52614037e5bf4298e9b0bf8d7253"
      }
    }
  }
}
