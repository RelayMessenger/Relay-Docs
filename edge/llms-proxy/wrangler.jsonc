{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-docs-llms-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "relay-docs-llms-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.staging.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-staging.mintlify.app",
        "LLMS_VERSION": "3438a81c3141b04f1b83bce5ccc97198b1993e88ffc602970c1ef00fb70983f5",
        "LLMS_FULL_VERSION": "c7caf283aa88c7e4678c52e9ff35ff88f3d76f7e3f8282c6c9611821b72abe31"
      }
    }
  }
}
