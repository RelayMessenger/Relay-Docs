{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-docs-llms-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "relay-docs-llms-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.staging.relayapp.im",
          "custom_domain": true
        }
      ],
      "vars": {
        "MINTLIFY_ORIGIN": "https://relay-staging.mintlify.app",
        "LLMS_VERSION": "3aaaee33b2e98e53824669976e4eb36c45e55af6fce100e48f4a5ca50991fbd1",
        "LLMS_FULL_VERSION": "46257dfaa43a4631415e47f2d4e4f681ad95ecbcacfcc4a531016802327ac002"
      }
    }
  }
}
