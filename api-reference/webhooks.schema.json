{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/webhooks/2026-08-28.json",
  "title": "Relay webhook event 2026-08-28",
  "description": "Complete webhook union for Relay Developer API v1. Delivery is signed, at least once, and unordered.",
  "oneOf": [
    {
      "$ref": "#/$defs/MessageReceivedEvent"
    },
    {
      "$ref": "#/$defs/MessageSentEvent"
    },
    {
      "$ref": "#/$defs/MessageDeliveredEvent"
    },
    {
      "$ref": "#/$defs/MessageReadEvent"
    },
    {
      "$ref": "#/$defs/ReactionAddedEvent"
    },
    {
      "$ref": "#/$defs/ReactionRemovedEvent"
    },
    {
      "$ref": "#/$defs/ChatCreatedEvent"
    },
    {
      "$ref": "#/$defs/ChatTitleUpdatedEvent"
    },
    {
      "$ref": "#/$defs/ChatAvatarUpdatedEvent"
    },
    {
      "$ref": "#/$defs/ParticipantAddedEvent"
    },
    {
      "$ref": "#/$defs/ParticipantRemovedEvent"
    },
    {
      "$ref": "#/$defs/TypingStartedEvent"
    },
    {
      "$ref": "#/$defs/TypingStoppedEvent"
    }
  ],
  "$defs": {
    "HumanIdentity": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "kind",
        "username",
        "phone_number",
        "display_name",
        "avatar_url",
        "created_at"
      ],
      "properties": {
        "object": {
          "const": "identity"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "human"
        },
        "username": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_]{3,32}$"
        },
        "phone_number": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9][0-9]{1,14}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "avatar_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AgentIdentity": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "kind",
        "username",
        "display_name",
        "avatar_url",
        "created_at"
      ],
      "properties": {
        "object": {
          "const": "identity"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "agent"
        },
        "username": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_]{3,32}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "avatar_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Identity": {
      "x-relay-object-version": "2026-08-28",
      "oneOf": [
        {
          "$ref": "#/$defs/HumanIdentity"
        },
        {
          "$ref": "#/$defs/AgentIdentity"
        }
      ]
    },
    "ChatParticipant": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "identity",
        "status",
        "joined_at",
        "left_at"
      ],
      "properties": {
        "object": {
          "const": "chat_participant"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "status": {
          "enum": [
            "active",
            "left",
            "removed"
          ]
        },
        "joined_at": {
          "type": "string",
          "format": "date-time"
        },
        "left_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "Chat": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "type",
        "title",
        "avatar_url",
        "participants",
        "membership_version",
        "last_sequence",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "object": {
          "const": "chat"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "direct",
            "group"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "avatar_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ChatParticipant"
          }
        },
        "membership_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Decimal string."
        },
        "last_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Decimal string; parse as an arbitrary-precision nonnegative integer."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Attachment": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "filename",
        "mime_type",
        "size_bytes",
        "status",
        "sha256",
        "width",
        "height",
        "duration_ms",
        "created_at",
        "available_at"
      ],
      "properties": {
        "object": {
          "const": "attachment"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "status": {
          "enum": [
            "pending",
            "available",
            "failed",
            "rejected",
            "deleted"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "TextPart": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "index",
        "type",
        "text"
      ],
      "properties": {
        "object": {
          "const": "message_part"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "ImagePart": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "index",
        "type",
        "attachment",
        "alt_text"
      ],
      "properties": {
        "object": {
          "const": "message_part"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "type": {
          "const": "image"
        },
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "alt_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "FilePart": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "index",
        "type",
        "attachment"
      ],
      "properties": {
        "object": {
          "const": "message_part"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "type": {
          "const": "file"
        },
        "attachment": {
          "$ref": "#/$defs/Attachment"
        }
      }
    },
    "AudioPart": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "index",
        "type",
        "attachment",
        "presentation",
        "waveform"
      ],
      "properties": {
        "object": {
          "const": "message_part"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "type": {
          "const": "audio"
        },
        "attachment": {
          "$ref": "#/$defs/Attachment"
        },
        "presentation": {
          "enum": [
            "file",
            "voice"
          ]
        },
        "waveform": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LinkPreview": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "status",
        "title",
        "description",
        "image_attachment_id"
      ],
      "properties": {
        "object": {
          "const": "link_preview"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "status": {
          "enum": [
            "pending",
            "available",
            "failed"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "image_attachment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "LinkPart": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "index",
        "type",
        "url",
        "fallback_text",
        "preview"
      ],
      "properties": {
        "object": {
          "const": "message_part"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "type": {
          "const": "link"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "fallback_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "preview": {
          "$ref": "#/$defs/LinkPreview"
        }
      }
    },
    "MessagePart": {
      "x-relay-object-version": "2026-08-28",
      "oneOf": [
        {
          "$ref": "#/$defs/TextPart"
        },
        {
          "$ref": "#/$defs/ImagePart"
        },
        {
          "$ref": "#/$defs/FilePart"
        },
        {
          "$ref": "#/$defs/AudioPart"
        },
        {
          "$ref": "#/$defs/LinkPart"
        }
      ]
    },
    "ReplyTarget": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "message_id",
        "part_id",
        "part_index"
      ],
      "properties": {
        "object": {
          "const": "reply_target"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "part_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "part_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "Failure": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "object": {
          "const": "failure"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "MessageReceipt": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "recipient",
        "delivered_at",
        "read_at"
      ],
      "properties": {
        "object": {
          "const": "message_receipt"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "recipient": {
          "$ref": "#/$defs/Identity"
        },
        "delivered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "read_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "Message": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "id",
        "chat_id",
        "sequence",
        "direction",
        "sender",
        "parts",
        "reply_to",
        "status",
        "receipt_summary",
        "receipts",
        "failure",
        "created_at",
        "sent_at"
      ],
      "properties": {
        "object": {
          "const": "message"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Decimal string; parse as an arbitrary-precision nonnegative integer."
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "sender": {
          "$ref": "#/$defs/Identity"
        },
        "parts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/MessagePart"
          }
        },
        "reply_to": {
          "oneOf": [
            {
              "$ref": "#/$defs/ReplyTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "accepted",
            "sent",
            "failed"
          ]
        },
        "receipt_summary": {
          "enum": [
            "none",
            "partial",
            "delivered",
            "read"
          ]
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageReceipt"
          }
        },
        "failure": {
          "oneOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "sent_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "Reaction": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "message_id",
        "target_part_id",
        "actor",
        "emoji",
        "slot_version",
        "created_at",
        "part_index"
      ],
      "properties": {
        "object": {
          "const": "reaction"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_part_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "actor": {
          "$ref": "#/$defs/Identity"
        },
        "emoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "slot_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Decimal string; parse as an arbitrary-precision nonnegative integer."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "part_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "MessageEventData": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "message"
      ],
      "properties": {
        "object": {
          "const": "message_event_data"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      }
    },
    "DeliveredData": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "message_id",
        "chat_id",
        "chat_sequence",
        "recipient",
        "delivered_at"
      ],
      "properties": {
        "object": {
          "const": "message_delivered_event_data"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "chat_sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Decimal string; parse as an arbitrary-precision nonnegative integer."
        },
        "recipient": {
          "$ref": "#/$defs/Identity"
        },
        "delivered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ReadData": {
      "type": "object",
      "x-relay-object-version": "2026-08-28",
      "additionalProperties": true,
      "required": [
        "object",
        "object_version",
        "chat_id",
        "reader",
        "through_sequence",
        "through_message_id",
        "read_at"
      ],
      "properties": {
        "object": {
          "const": "message_read_event_data"
        },
        "object_version": {
          "const": "2026-08-28"
        },
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "reader": {
          "$ref": "#/$defs/Identity"
        },
        "through_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Decimal string; parse as an arbitrary-precision nonnegative integer."
        },
        "through_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "read_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
