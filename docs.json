{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Relay",
  "description": "Relay API v1 documentation.",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "params": {
      "expanded": "closed"
    },
    "examples": {
      "languages": [
        "curl"
      ],
      "defaults": "required"
    }
  },
  "favicon": "/favicon-staging.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://relayapp.im"
  },
