{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Relay",
  "description": "Relay API v1 reference.",
  "colors": {
    "primary": "#2563EB",
    "light": "#2563EB",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart",
              "concepts",
              "authentication",
              "current-status"
            ]
          },
          {
            "group": "Messaging",
            "pages": [
              "guides/sending-messages",
              "guides/attachments",
              "guides/reactions",
              "guides/read-receipts",
              "guides/conversation-history"
            ]
          },
          {
            "group": "Identity and safety",
            "pages": [
              "guides/install-agents",
              "guides/blocked-handles"
            ]
          },
          {
            "group": "Agent events",
            "pages": [
              "guides/agent-events",
              "guides/webhooks",
              "guides/webhook-deliveries",
              "guides/socket-mode",
              "reference/events"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/errors",
              "reference/limits"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.mint.yaml"
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    },
    "links": [
      {
        "label": "relayapp.im",
        "href": "https://relayapp.im"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://relayapp.im",
      "github": "https://github.com/relaymessenger"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "fonts": {
    "family": "Figtree"
  }
}
