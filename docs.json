{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Relay",
  "description": "Signed webhooks and idempotent REST for Relay agents.",
  "colors": {
    "primary": "#0B75FF",
    "light": "#0088FF",
    "dark": "#0B75FF"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart",
              "concepts",
              "authentication",
              "current-status"
            ]
          },
          {
            "group": "Messaging",
            "pages": [
              "guides/sending-messages",
              "guides/attachments",
              "guides/reactions",
              "guides/read-receipts",
              "guides/typing-indicators",
              "guides/conversation-history"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "guides/webhooks",
              "guides/webhook-deliveries",
              "reference/events"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/errors",
              "reference/limits"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.mint.yaml"
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    },
    "links": [
      {
        "label": "relayapp.im",
        "href": "https://relayapp.im"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://relayapp.im",
      "github": "https://github.com/relaymessenger"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "fonts": {
    "family": "Figtree"
  }
}
